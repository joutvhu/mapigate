{
  "name": "mapigate",
  "version": "0.1.0",
  "description": "AI Model API Gateway & Token Optimizer for coding tools",
  "main": "dist/server/index.js",
  "bin": {
    "mapigate": "bin/mapigate.js",
    "mpg": "bin/mapigate.js"
  },
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development MAPIGATE_DEV=1 concurrently -k -p \"[{name}]\" -n \"SERVER,WEB\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cross-env NODE_ENV=development MAPIGATE_DEV=1 tsx watch src/server/index.ts",
    "dev:web": "vite src/web",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build src/web --outDir ../../dist/web",
    "start": "node dist/server/index.js",
    "test": "tsx --import ./tests/setup.ts --test --test-concurrency=1 tests/**/*.test.ts",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xyflow/react": "^12.12.0",
    "commander": "^13.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "material-symbols": "^0.48.0",
    "node-forge": "^1.4.0",
    "node-machine-id": "^1.1.12",
    "sql.js": "^1.12.0",
    "undici": "^8.11.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "chalk": "^5.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "lucide-react": "^0.475.0",
    "ora": "^8.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "zustand": "^5.0.3"
  },
  "keywords": [
    "ai",
    "router",
    "token-saver",
    "claude-code",
    "cursor",
    "cline",
    "llm-proxy"
  ],
  "author": "Giao Ho",
  "license": "MIT"
}
